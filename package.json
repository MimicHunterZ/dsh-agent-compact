{
  "name": "@mimichunterz/agent-compact",
  "version": "0.1.0",
  "description": "Context compression tools (context_surface / context_archive / context_compact) plus an optimized compaction engine for DeepSeek Harness: full-context summarization input + scoped #k..#m instruction, ~80% cheaper input via KV-cache reuse.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./engine": {
      "types": "./lib/engine.d.ts",
      "default": "./lib/engine.js"
    },
    "./optimizer": {
      "types": "./lib/optimizer.d.ts",
      "default": "./lib/optimizer.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction-basic": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction-basic": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "bundle",
    "context-compression",
    "compaction",
    "kv-cache"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
